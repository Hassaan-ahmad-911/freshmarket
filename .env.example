APP_NAME=FreshMarket
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Port used by `php artisan serve` / `composer run dev` (8000 is often taken by other dev servers)
SERVER_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL is the intended database. For a zero-setup local run you can
# instead set DB_CONNECTION=sqlite and delete the other DB_ lines.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=freshmarket
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@freshmarket.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Stripe (test mode) -----------------------------------------------
# Leave STRIPE_SECRET empty to use the built-in FakeGateway (no Stripe needed).
# Get test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_KEY=
STRIPE_SECRET=
# Printed by: stripe listen --forward-to localhost:8000/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Country of connected accounts created for suppliers (must match what your platform can transfer to)
STRIPE_CONNECT_COUNTRY=US

# --- FreshMarket defaults (money in cents, percentages in basis points) --
FRESHMARKET_CURRENCY=usd
FRESHMARKET_COMMISSION_BPS=1000
FRESHMARKET_DELIVERY_FEE=499
FRESHMARKET_FREE_DELIVERY_THRESHOLD=5000
